{
  "version": 1,
  "hooks": {
    "afterShellExecution": [
      {
        "command": "python3 .cursor/hooks/qa-after-godot.py",
        "matcher": "godot",
        "timeout": 15
      }
    ],
    "postToolUse": [
      {
        "command": "python3 .cursor/hooks/qa-post-shell.py",
        "matcher": "Shell",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/qa-stop-followup.py",
        "loop_limit": 25,
        "timeout": 15
      }
    ]
  }
}
